# Copy to ~/.config/secrets/gemini-web.env and chmod 600.
# Session cookies for the `geminiweb-think` lane (the Gemini WEB APP on a paid
# plan). UNOFFICIAL -- read docs/COOKIES.md first. Extract both from the browser
# profile signed into your paid Gemini account, for the .google.com domain.
# __Secure-1PSIDTS rotates ~daily; the wrapper rewrites it here after each call.
GEMINI_WEB_1PSID=
GEMINI_WEB_1PSIDTS=
